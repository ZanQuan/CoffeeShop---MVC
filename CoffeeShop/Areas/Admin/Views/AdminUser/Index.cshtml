@model List<Microsoft.AspNetCore.Identity.IdentityUser>
<h1 class="h3 mb-4 text-gray-800">Manage User</h1>
<div class="card shadow mb-4">
    <div class="card-body">
        <table class="table table-bordered">
            <thead class="thead-light">
                <tr><th>#</th><th>Email</th><th>Username</th><th>Action</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model[i].Email</td>
                        <td>@Model[i].UserName</td>
                        <td>
                            <a asp-action="ManageRole" asp-route-userId="@Model[i].Id"
                               class="btn btn-sm btn-info">Manage Role</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>