@model List<CoffeeShop.Models.Contact>
<h1 class="h3 mb-4 text-gray-800">Contact Messages</h1>
<div class="card shadow mb-4">
    <div class="card-body">
        <table class="table table-bordered">
            <thead class="thead-light">
                <tr><th>#</th><th>Tên</th><th>Email</th><th>Nội dung</th><th>Ngày gửi</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@Model[i].Name</td>
                        <td>@Model[i].Email</td>
                        <td>@Model[i].Message</td>
                        <td>@Model[i].SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>